;; defsrc is still necessary
(defcfg
 process-unmapped-keys yes
 )

(defsrc
 caps f g k l
 )
(defvar
 tap-time 150
 hold-time 200
 )

	(defalias
	 escctrl (tap-hold $tap-time $hold-time esc lctl)
	 f (multi f24 (tap-hold $tap-time $hold-time f lmet))
	 g (multi f24 (tap-hold $tap-time $hold-time g lsft))
	 k (multi f24 (tap-hold $tap-time $hold-time k rsft))
	 l (multi f24 (tap-hold $tap-time $hold-time l rctrl))
	)

	(deflayer base
	 @escctrl @f @g @k @l
	)
